# 复制本文件为 local.properties（已在 .gitignore，不会提交），填入真实值
# Windows 路径注意反斜杠转义：sdk.dir=C\:\\Users\\<用户名>\\AppData\\Local\\Android\\Sdk

sdk.dir=C\:\\Users\\<你的用户名>\\AppData\\Local\\Android\\Sdk

# debug 构建预填的 Key（release 构建永远为空，使用者自行填写）
MINERU_API_KEY=sk-你的mineru-key
# 大模型接入：任何 OpenAI 兼容服务都行；只填根域名时客户端会自动补 /v1
LLM_API_KEY=sk-你的大模型key
LLM_BASE_URL=https://cf.a-piko.top
LLM_MODEL=deepseek-v4.1-flash
